{
  "name": "omnitrace",
  "version": "1.1.0",
  "description": "Open-source, privacy-first AI log debugger for real-time error analysis with automatic secret sanitization",
  "type": "commonjs",
  "author": "Aditya Wadhonkar <https://github.com/adityv>",
  "main": "index.js",
  "bin": {
    "omnitrace": "./bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "index.js",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "assets",
    "screenshots"
  ],
  "scripts": {
    "start": "node ./bin/cli.js",
    "test": "node --test",
    "lint": "node --check ./bin/cli.js && node --check ./src/config.js && node --check ./src/sanitizer.js && node --check ./src/watcher.js && node --check ./src/ai.js && node --check ./src/demo.js && node --check ./src/ui.js && eslint .",
    "coverage": "c8 --all --include=src --check-coverage --lines 75 --functions 75 --branches 65 --reporter=text npm test",
    "security": "npm audit --omit=dev --audit-level=moderate",
    "package-check": "npm pack --dry-run",
    "demo": "node ./bin/cli.js demo"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "keywords": [
    "cli",
    "logs",
    "debugging",
    "ai",
    "ollama",
    "openai",
    "privacy",
    "developer-tools",
    "incident-response",
    "log-analysis",
    "secret-redaction"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adityv/omnitrace.git"
  },
  "bugs": {
    "url": "https://github.com/adityv/omnitrace/issues"
  },
  "homepage": "https://getomnitrace.bond",
  "dependencies": {
    "axios": "^1.7.9",
    "chalk": "^4.1.2",
    "chokidar": "^4.0.3",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "eslint": "^8.57.1"
  }
}
